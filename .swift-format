{
    "version": 1,
    "lineLength": 120,
    "indentation": {
        "spaces": 4
    },
    "respectsExistingLineBreaks": false,
    "lineBreakBeforeEachArgument": false,
    "lineBreakBeforeEachGenericRequirement": false,
    "multiElementCollectionTrailingCommas": false,
    "maximumBlankLines": 1,
    "tabWidth": 4
}
