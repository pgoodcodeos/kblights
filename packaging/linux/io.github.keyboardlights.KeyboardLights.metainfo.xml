<component type="desktop-application">
    <id>io.github.keyboardlights.KeyboardLights</id>
    <metadata_license>MIT</metadata_license>
    <project_license>Apache-2.0</project_license>
    <name>KeyboardLights</name>
    <summary>Configure legacy Cloud Nine C989 keyboards</summary>
    <url type="homepage">https://github.com/pgoodcodeos/kblights</url>
    <url type="bugtracker">https://github.com/pgoodcodeos/kblights/issues</url>
    <developer id="io.github.keyboardlights">
        <name>oscoder47</name>
    </developer>
    <content_rating type="oars-1.1"/>
    <description>
        <p>
            Customize lighting and key assignments on a legacy Cloud Nine C989
            keyboard with firmware 1.38. Preview edits, save local profiles, and
            review changes before applying them to the keyboard.
        </p>
        <p>
            Revised keyboards with firmware 1.82 are incompatible. Run as your
            normal desktop user and reconnect the keyboard after installation.
        </p>
    </description>
    <launchable type="desktop-id">io.github.keyboardlights.KeyboardLights.desktop</launchable>
    <provides>
        <binary>keyboardlights</binary>
        <modalias>usb:v0C45p8006d0138*</modalias>
    </provides>
    <categories>
        <category>Settings</category>
        <category>HardwareSettings</category>
    </categories>
</component>
